{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/refund-policy",
      "destination": "https://www.goldengateiptv.pt/refund",
      "statusCode": 302
    },
    {
      "source": "/privacy-policy",
      "destination": "https://www.goldengateiptv.pt/privacy",
      "statusCode": 302
    },
    {
      "source": "/terms-and-conditions",
      "destination": "https://www.goldengateiptv.pt/terms",
      "statusCode": 302
    },
    {
      "source": "/product-category/:path*",
      "destination": "https://www.goldengateiptv.pt/#planos",
      "statusCode": 302
    },
    {
      "source": "/feed",
      "destination": "https://www.goldengateiptv.pt/blog",
      "statusCode": 302
    },
    {
      "source": "/iptv-portuguesse-plano-expansao",
      "destination": "https://www.goldengateiptv.pt/iptv-portugal-guia",
      "statusCode": 302
    },
    {
      "source": "/",
      "destination": "https://www.goldengateiptv.pt/",
      "statusCode": 302
    },
    {
      "source": "/:path*",
      "destination": "https://www.goldengateiptv.pt/:path*",
      "statusCode": 302
    }
  ]
}
